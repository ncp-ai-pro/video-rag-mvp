# Leave these as mock for a fully local smoke test.
DATABASE_PATH=data/video_rag.db
EMBEDDING_PROVIDER=mock
CHAT_PROVIDER=mock
# Use true only after serving HTTPS on the private server.
SESSION_COOKIE_SECURE=false

# Set both to clova when testing with CLOVA Studio. Never commit the key.
# EMBEDDING_PROVIDER=clova
# CHAT_PROVIDER=clova
# CLOVASTUDIO_API_KEY=<YOUR_CLOVA_STUDIO_API_KEY>
# CLOVA_MODEL=HCX-DASH-002

# Required only when a video has no subtitles and CLOVA Speech must be called.
# CLOVA_SPEECH_INVOKE_URL=<YOUR_CLOVA_SPEECH_INVOKE_URL>
# CLOVA_SPEECH_API_KEY=<YOUR_CLOVA_SPEECH_API_KEY>
