server {
    listen 80;
    server_name _;

    # Expose the responding web container hostname so ALB distribution can be
    # checked from browser DevTools or curl response headers.
    add_header X-Backend-Host $hostname always;

    root /usr/share/nginx/html;
    index index.html;

    location = /health {
        access_log off;
        default_type text/plain;
        add_header X-Backend-Host $hostname always;
        return 200 "ok\n";
    }

    # React SPA fallback. This keeps deep links such as /workspace working after
    # refresh because the browser app, not Nginx, owns client-side routing.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # /runtime-config.js is served by the API backend at its root path (not under
    # /api), so it needs its own proxy rule. Without this it falls through to the
    # SPA fallback above and the browser gets index.html back for a <script src>
    # request, which fails with "Unexpected token '<'".
    location = /runtime-config.js {
        proxy_pass ${BACKEND_INGRESS_ORIGIN}/runtime-config.js;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "no-store" always;
    }

    # Backend entrypoint. In production this points to the NKS private ALB
    # created by the NKS Gateway API Adapter.
    #
    # Browser-facing requests keep the /api prefix, but FastAPI and Chat
    # services do not serve under /api. Strip it here before forwarding:
    # - /api/chat* -> /chat* -> chat-service
    # - /api/*     -> /*     -> api-service
    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass ${BACKEND_INGRESS_ORIGIN};
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Required for SSE endpoints such as /api/videos/{video_id}/events.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
